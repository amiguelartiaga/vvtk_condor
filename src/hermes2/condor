#!/bin/bash

#-------------------------------------------------------------------
# help / no-args guard
if [[ $# -eq 0 || "$1" == "--help" || "$1" == "-h" ]]; then
    cat <<'HELP'
Usage: condor [OPTIONS] EXECUTABLE [ARGS...]

Submit a job to HTCondor. Defaults: blocking and any node.

Options:
    --noblock   Return immediately instead of waiting for the job to finish
    --nolock    With --noblock, skip lock-file checks and creation
    --nodate    Use legacy log names without appending a timestamp
    --cpu       Disable GPU useful for scripting
    --nice      Run as nice user (lower priority)
    --target M  Pin the job to machine M (e.g. vivoidenty02). Give several
                machines comma-separated (vivoidenty01,vivoidenty02) or repeat
                --target; condor picks whichever has a free slot. The
                +Architecture the node accepts is chosen from the name:
                a100* -> A100, 2nv3090* -> 2GPU3090, nv3090* -> GPU3090,
                others (her*) -> none
    --arch A    Force +Architecture=A (e.g. A100, 4A100, 2GPU3090, GPU3090)
    --gpus N    Request N GPUs (request_gpus = N; e.g. 2 on 2nv3090-02,
                up to 4 on a100-02)
    --autoenv   When EXECUTABLE is python and a venv/conda env is active,
                wrap the job in an auto-generated activate script
    --tail      After submitting, wait for the job output to appear and
                stream it live with tail -f (implies --noblock)
    --help      Show this help message

Examples:
    condor my_script.sh                        # blocking job
    condor --noblock my_script.sh arg1 arg2    # non-blocking job
    condor --nodate my_script.sh               # Reuse legacy non-dated log names
    condor --cpu my_script.sh                  # CPU-mode compatibility
    condor --nice my_script.sh                 # Nice job
    condor --cpu my_script.sh -x 5             # CPU-mode job with args
    condor --target vivoidenty02 my_script.sh  # Job pinned to vivoidenty02
    condor --target vivoidenty01,vivoidenty02 my_script.sh  # Job on whichever is free
    condor --nice --target a100-01,a100-02 my_script.sh     # A100 (+Architecture="A100")
    condor --nice --target 2nv3090-02 --gpus 2 my_script.sh # both GPUs of 2nv3090-02
    condor --autoenv python hello.py           # Run python inside the active venv/conda env

Optional shell aliases (installer can add them to ~/.bashrc):
    condor_cpu        →  condor --cpu
  condor_nice       →  condor --nice
HELP
    exit 0
fi

#-------------------------------------------------------------------
# parse options: --noblock, --nolock, --nodate, --cpu, --nice, --autoenv, --target
BLOCK_MODE="block"
NOLOCK=false
APPEND_DATE=true
NICE_MODE=false
TARGET_MACHINES=""
CPU_MODE=false
ARCH_OVERRIDE=""
REQUEST_GPUS=""
AUTOENV=false
TAIL_MODE=false

while [[ "$1" == --* ]]; do
    case "$1" in
        --noblock)
            BLOCK_MODE="noblock"
            shift
            ;;
        --nolock)
            NOLOCK=true
            shift
            ;;
        --nodate)
            APPEND_DATE=false
            shift
            ;;
        --cpu)
            CPU_MODE=true
            shift
            ;;
        --arch)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "ERROR: --arch requires a value (e.g. A100, 4A100, 2GPU3090, GPU3090)"
                exit 1
            fi
            ARCH_OVERRIDE="$2"
            shift
            shift
            ;;
        --gpus)
            if [[ ! "$2" =~ ^[0-9]+$ ]]; then
                echo "ERROR: --gpus requires a number (e.g. --gpus 2)"
                exit 1
            fi
            REQUEST_GPUS="$2"
            shift
            shift
            ;;
        --target)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "ERROR: --target requires one or more machine names (e.g. vivoidenty02 or vivoidenty01,vivoidenty02)"
                exit 1
            fi
            # accumulate: both "--target a,b" and repeated --target work
            TARGET_MACHINES="${TARGET_MACHINES:+${TARGET_MACHINES},}$2"
            shift
            shift
            ;;
        --nice)
            NICE_MODE=true
            shift
            ;;
        --autoenv)
            AUTOENV=true
            shift
            ;;
        --tail)
            TAIL_MODE=true
            shift
            ;;
        *)
            break
            ;;
    esac
done

# --tail implies noblock (we do our own waiting)
if [[ "$TAIL_MODE" == true ]]; then
    BLOCK_MODE="noblock"
fi

USE_LOCK=true
if [[ "$BLOCK_MODE" == "noblock" && "$NOLOCK" == true ]]; then
    USE_LOCK=false
fi

file=$1

#-------------------------------------------------------------------
# create dir
mkdir -p .condor/

#-------------------------------------------------------------------
# base filename
args="$*"
args=${args// /_} 
args=${args//-/_} 
args=${args//\//_} 
file_condor_base=$args
if [[ "$APPEND_DATE" == true ]]; then
    file_condor_base="${file_condor_base}_$(date +%Y%m%d_%H%M%S_%N)"
fi

#-------------------------------------------------------------------
# autoenv: when the executable is python and an active venv/conda env is
# detected, wrap the call in a generated activate script so the job runs
# inside that environment.
EXEC_PATH=$(command -v "$file" 2>/dev/null || readlink -f "$file")
if [[ "$AUTOENV" == true && "$(basename "$file")" == "python" ]]; then
    env_type=$(python - <<'PYEOF'
import sys, os
p = os.path.realpath(sys.executable)
if "/miniconda3/envs/" in p or "/anaconda3/envs/" in p:
    print("conda_named")
elif p.endswith("/miniconda3/bin/python") or p.endswith("/anaconda3/bin/python"):
    print("conda_base")
elif sys.prefix != getattr(sys, "base_prefix", sys.prefix):
    print("venv")
else:
    print("none")
PYEOF
)
    if [[ "$env_type" == "none" ]]; then
        echo "autoenv: no active virtual environment detected, running python directly"
    else
        py_path=$(which python)
        activate_path="$(dirname "$py_path")/activate"
        if [[ ! -f "$activate_path" ]]; then
            echo "autoenv: WARNING activate script not found at $activate_path, running python directly"
        else
            wrapper=".condor/${file_condor_base}_activate.sh"
            cat > "$wrapper" <<WRAP
#!/bin/bash
# Auto-generated by condor --autoenv
# Detected environment: $env_type
source "$activate_path"
exec python "\$@"
WRAP
            chmod +x "$wrapper"
            EXEC_PATH=$(readlink -f "$wrapper")
            echo "autoenv: detected $env_type, wrapper $wrapper -> $activate_path"
        fi
    fi
fi

#-------------------------------------------------------------------
# lock check: warn if a previous job with the same name is still running
lock_file=.condor/${file_condor_base}._lock
clog_file=.condor/${file_condor_base}._clog
if [[ "$USE_LOCK" == true && -f "$lock_file" ]]; then
    if [[ -f "$clog_file" ]] && grep -qE '^005|^009' "$clog_file"; then
        echo "Previous job finished. Removing stale lock."
        rm -f "$lock_file"
    else
        echo -e "\e[1;31mWARNING: A job with the same name is already running or queued!\e[0m"
        echo -e "\e[1;31mLock file: $lock_file\e[0m"
        echo -e "\e[1;33mIf the previous job is no longer running, remove the lock manually:\e[0m"
        echo -e "\e[1;33m  rm $lock_file\e[0m"
        exit 1
    fi
fi

#-------------------------------------------------------------------
# choose +Architecture: hermes nodes only START jobs whose ARCHITECTURE they
# list (checked on hermes2 with condor_status -l, 2026-10-12):
#   a100-01  (1 A100):  "GPUA100" or "A100"
#   a100-02  (4 A100):  "A100" or "4A100"          -> we use "A100" for both
#   2nv3090-02 (2 GPUs): "2GPU3090"
#   nv3090-*  (1 GPU):  "GPU3090"                  (the old fixed default)
#   her*, other CPU nodes: no +Architecture (UNDEFINED)
# Derived from --target names, overridden by --arch; without --target:
# GPU3090 for GPU jobs, none for --cpu jobs.
ARCH=""
if [[ -n "$ARCH_OVERRIDE" ]]; then
    ARCH="$ARCH_OVERRIDE"
elif [[ -n "$TARGET_MACHINES" ]]; then
    IFS=',' read -r -a _arch_targets <<< "$TARGET_MACHINES"
    for m in "${_arch_targets[@]}"; do
        m="${m// /}"
        [[ -z "$m" ]] && continue
        case "${m%%.*}" in
            a100*)    a="A100" ;;
            2nv3090*) a="2GPU3090" ;;
            nv3090*)  a="GPU3090" ;;
            *)        a="UNDEFINED" ;;
        esac
        if [[ -z "$ARCH" ]]; then
            ARCH="$a"
        elif [[ "$ARCH" != "$a" ]]; then
            echo "ERROR: the --target machines need different +Architecture values ($ARCH vs $a for $m)."
            echo "       Submit them separately, or force one value with --arch NAME."
            exit 1
        fi
    done
elif [[ "$CPU_MODE" == true ]]; then
    ARCH="UNDEFINED"
else
    ARCH="GPU3090"
fi
if [[ "$ARCH" == "UNDEFINED" || -z "$ARCH" ]]; then
    ARCH_LINE="#+Architecture: none (CPU / generic nodes)"
else
    ARCH_LINE="+Architecture=\"${ARCH}\""
fi
GPUS_LINE="#request_gpus: not set"
if [[ -n "$REQUEST_GPUS" ]]; then
    GPUS_LINE="request_gpus          = ${REQUEST_GPUS}"
fi
echo "Architecture: ${ARCH}${REQUEST_GPUS:+, request_gpus=${REQUEST_GPUS}}"

#-------------------------------------------------------------------
# create condor config
condor_task=.condor/${file_condor_base}._sub

#-------------------------------------------------------------------
if [ -f condor.cfg ];
then
    echo "condor.cfg exists."
    cp condor.cfg ${condor_task} 
    CFG_ARCH=$(grep -i '^[[:space:]]*+Architecture' condor.cfg | head -1 | sed -E 's/.*=[[:space:]]*"?([^"]*)"?.*/\1/')
    if [[ -n "$CFG_ARCH" && ( -n "$TARGET_MACHINES" || -n "$ARCH_OVERRIDE" ) && "$ARCH" != "UNDEFINED" && "$CFG_ARCH" != "$ARCH" ]]; then
        echo -e "\e[1;33mWARNING: condor.cfg sets +Architecture=\"$CFG_ARCH\" but the target needs \"$ARCH\": the job may never start.\e[0m"
    fi
    if ! grep -qi '^[[:space:]]*+Architecture' condor.cfg && [[ "$ARCH_LINE" != \#* ]]; then
        echo "${ARCH_LINE}" >> ${condor_task}
        echo "  (condor.cfg has no +Architecture: added ${ARCH_LINE})"
    fi
    if [[ -n "$REQUEST_GPUS" ]] && ! grep -qi '^[[:space:]]*request_gpus' condor.cfg; then
        echo "${GPUS_LINE}" >> ${condor_task}
    fi
else
   echo "condor.cfg does not exist, creating default"

   # build nice_user line
   if [[ "$NICE_MODE" == true ]]; then
       NICE_LINE="nice_user             = True"
   else
       NICE_LINE="#nice_user             = True"
   fi

#::::::::::::::::::::::::::::::::::::::::::
cat > ${condor_task}  << EOF

universe              = vanilla
notification          = Never 
${NICE_LINE}
getenv                = True
${ARCH_LINE}
${GPUS_LINE}
should_transfer_files = no

EOF
#::::::::::::::::::::::::::::::::::::::::::
fi

#-------------------------------------------------------------------
# if --target, pin the job to one or more machines.
# --target accepts short names (vivoidenty02) and completes them with this
# host's domain. Several machines may be given comma-separated or by
# repeating --target; condor then runs the job on whichever one has a free slot.
if [[ -n "$TARGET_MACHINES" ]]; then
    TARGET_REQ=""
    IFS=',' read -r -a _targets <<< "$TARGET_MACHINES"
    for m in "${_targets[@]}"; do
        m="${m// /}"
        [[ -z "$m" ]] && continue
        if [[ "$m" != *.* && "$HOSTNAME" == *.* ]]; then
            m="${m}.${HOSTNAME#*.}"
        fi
        TARGET_REQ="${TARGET_REQ:+${TARGET_REQ} || }TARGET.Machine == \"${m}\""
    done
    if [[ -z "$TARGET_REQ" ]]; then
        echo "ERROR: --target needs at least one machine name (e.g. vivoidenty02 or vivoidenty01,vivoidenty02)"
        exit 1
    fi
    echo "requirements   = ( ${TARGET_REQ} )" >> ${condor_task}
fi

#-------------------------------------------------------------------

#::::::::::::::::::::::::::::::::::::::::::
cat >> ${condor_task} << EOF
executable = ${EXEC_PATH}
arguments  = ${@:2}
output     = .condor/${file_condor_base}.log
error      = .condor/${file_condor_base}.err
log        = .condor/${file_condor_base}._clog
queue

EOF
#::::::::::::::::::::::::::::::::::::::::::

#-------------------------------------------------------------------
# view the condor config

#cat ${condor_task}

#-------------------------------------------------------------------
# clean old condor log so condor_wait doesn't see stale events
rm -f .condor/${file_condor_base}._clog

#-------------------------------------------------------------------
# create lock file
if [[ "$USE_LOCK" == true ]]; then
    touch "$lock_file"
fi


#-------------------------------------------------------------------
# launch condor job

#-------------------------------------------------------------------
# log
echo "-----------------------------"    
echo "log output: .condor/${file_condor_base}.log"
echo "err output: .condor/${file_condor_base}.err"
echo "-----------------------------"

if [[ "$BLOCK_MODE" == "block" ]]; then
    # block until the job is done
    _condor_submit.sh --sync y --config ${condor_task}
else
    # non-blocking call
    _condor_submit.sh --config ${condor_task}
fi

if [[ "$BLOCK_MODE" == "block" ]]; then
    echo "-----------------------------"
    echo "Job completed. "
    log_file=.condor/${file_condor_base}.log
    if [[ -f "$log_file" ]]; then
        line_count=$(wc -l < "$log_file")
        if (( line_count > 100 )); then
            head -n 20 "$log_file"
            echo "..."
            tail -n 20 "$log_file"
        else
            cat "$log_file"
        fi
    else
        cat "$log_file"
    fi
    if [[ "$USE_LOCK" == true ]]; then
        rm -f "$lock_file"
    fi
fi

#-------------------------------------------------------------------
# --tail: stream log+err live until the job finishes
if [[ "$TAIL_MODE" == true ]]; then
    log_file=.condor/${file_condor_base}.log
    err_file=.condor/${file_condor_base}.err
    echo "Waiting for job to start..."
    while [[ ! -f "$log_file" ]]; do
        sleep 0.5
    done
    # give .err a moment to be created alongside .log
    sleep 0.2
    if [[ -f "$err_file" ]]; then
        echo -e "Streaming output (Ctrl+C to stop):\n  stdout: $log_file\n  stderr: $err_file"
        tail -q -f "$log_file" "$err_file"
    else
        echo -e "Streaming output (Ctrl+C to stop):\n  stdout: $log_file"
        tail -q -f "$log_file"
    fi
fi

#-------------------------------------------------------------------
# clean
#rm -rf .condor/
