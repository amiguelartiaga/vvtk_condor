#!/bin/bash

#-------------------------------------------------------------------
# help / no-args guard
if [[ $# -eq 0 || "$1" == "--help" || "$1" == "-h" ]]; then
    cat <<'HELP'
Usage: condor_for [OPTIONS] EXECUTABLE [ARGS...] N_JOBS

Submit N_JOBS indexed jobs to HTCondor. Each job receives its index (0..N-1)
as the last argument. Defaults: GPU enabled, 2000 MB, blocking and any node.

Options:
    --noblock    Return immediately instead of waiting for jobs to finish
    --nolock     With --noblock, skip lock-file checks and creation
    --nodate     Use legacy log names without appending a timestamp
    --cpu        Disable GPU and request only 500 MB memory
    --memory N   Request N MB of memory explicitly
    --prio       Add +Prioridad = "Alta" to the submit config (alias of --level 3)
    --nice       Run as nice user (alias of --level 0)
    --level N    Priority level (0..3):
                   0 = nice jobs   (lowest priority, may be evicted)
                   1 = normal jobs (no nice, no prio)
                   2 = +Prioridad = "Media" (evicts level 0/1)
                   3 = +Prioridad = "Alta"  (evicts level 0/1/2)
    --local      Pin jobs to the current machine ($HOSTNAME)
    --target M   Pin jobs to machine M (e.g. voz08 or voz08.intra.unizar.es).
                 Give several machines comma-separated (voz04,voz08) or repeat
                 --target; condor picks whichever has a free slot
    --gpu-model M
                 Run the jobs on a node with GPU model M, or part of its name
                 (4090, 3090, "rtx pro"); several: 3090,4090. See condor_nodes
    --vram G     Run the jobs on a node whose GPUs have >= G GB of memory
                 (mixed nodes are skipped; combine with --gpu-model if needed)
    --dry-run    Write and print the submit file, but do not submit it
    --help       Show this help message

Examples:
    condor_for my_script.sh 10                        # 10 GPU jobs, blocking
    condor_for --noblock my_script.sh --arg1 10       # 10 GPU jobs, non-blocking
    condor_for --nodate my_script.sh 10               # Reuse legacy non-dated log names
    condor_for --cpu my_script.sh 20                  # 20 CPU-only jobs
    condor_for --nice --local my_script.sh 5          # 5 nice GPU jobs, local
    condor_for --target voz08 my_script.sh 5          # 5 GPU jobs on voz08
    condor_for --target voz04,voz08 my_script.sh 5    # 5 GPU jobs spread over voz04/voz08
    condor_for --gpu-model 4090 my_script.sh 5        # 5 GPU jobs on RTX 4090 nodes
    condor_for --vram 20 my_script.sh 5               # 5 GPU jobs on GPUs with >= 20 GB
    condor_for --dry-run --vram 20 my_script.sh 5     # Only show the submit file
    condor_for --memory 4000 my_script.sh 10          # 10 jobs with 4 GB
    condor_for --prio my_script.sh 10                 # 10 high-priority jobs (level 3)
    condor_for --level 0 my_script.sh 10              # 10 nice jobs   (lowest priority)
    condor_for --level 1 my_script.sh 10              # 10 normal jobs (no nice, no prio)
    condor_for --level 2 my_script.sh 10              # 10 Media-priority jobs
    condor_for --level 3 my_script.sh 10              # 10 Alta-priority jobs (same as --prio)
HELP
    exit 0
fi

#-------------------------------------------------------------------
# parse options: --noblock, --nolock, --nodate, --cpu, --memory, --prio, --nice, --local, --target, --gpu-model, --vram, --dry-run
BLOCK_MODE="block"
GPU_MODE=1
NOLOCK=false
APPEND_DATE=true
NICE_MODE=false
LOCAL_MODE=false
TARGET_MACHINES=""
GPU_MODEL=""
MIN_VRAM=""
DRY_RUN=false
PRIO_MODE=false
LEVEL=""
REQUEST_MEMORY=500

while [[ "$1" == --* ]]; do
    case "$1" in
        --noblock)
            BLOCK_MODE="noblock"
            shift
            ;;
        --nolock)
            NOLOCK=true
            shift
            ;;
        --nodate)
            APPEND_DATE=false
            shift
            ;;
        --cpu)
            GPU_MODE=0
            REQUEST_MEMORY=500
            shift
            ;;
        --memory)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "ERROR: --memory requires a value in MB"
                exit 1
            fi
            REQUEST_MEMORY="$2"
            shift
            shift
            ;;
        --prio)
            PRIO_MODE=true
            shift
            ;;
        --nice)
            NICE_MODE=true
            shift
            ;;
        --level)
            if [[ -z "$2" || ! "$2" =~ ^[0-3]$ ]]; then
                echo "ERROR: --level requires an integer in 0..3"
                exit 1
            fi
            LEVEL="$2"
            shift
            shift
            ;;
        --local)
            LOCAL_MODE=true
            shift
            ;;
        --gpu-model)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "ERROR: --gpu-model requires a GPU model (e.g. 4090 or 3090,4090; see condor_nodes)"
                exit 1
            fi
            GPU_MODEL="${GPU_MODEL:+${GPU_MODEL},}$2"
            shift
            shift
            ;;
        --vram)
            if [[ -z "$2" || ! "$2" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
                echo "ERROR: --vram requires a number of GB (e.g. 20)"
                exit 1
            fi
            MIN_VRAM="$2"
            shift
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --target)
            if [[ -z "$2" || "$2" == --* ]]; then
                echo "ERROR: --target requires one or more machine names (e.g. voz08 or voz04,voz08)"
                exit 1
            fi
            # accumulate: both "--target a,b" and repeated --target work
            TARGET_MACHINES="${TARGET_MACHINES:+${TARGET_MACHINES},}$2"
            shift
            shift
            ;;
        *)
            break
            ;;
    esac
done

USE_LOCK=true
if [[ "$BLOCK_MODE" == "noblock" && "$NOLOCK" == true ]]; then
    USE_LOCK=false
fi

# --level overrides --nice/--prio when provided
PRIO_TAG=""
if [[ "$PRIO_MODE" == true ]]; then
    PRIO_TAG="Alta"
fi
if [[ -n "$LEVEL" ]]; then
    NICE_MODE=false
    PRIO_TAG=""
    case "$LEVEL" in
        0) NICE_MODE=true ;;
        1) ;;
        2) PRIO_TAG="Media" ;;
        3) PRIO_TAG="Alta" ;;
    esac
fi

#-------------------------------------------------------------------
# --gpu-model / --vram: turn the GPU request into a list of machines using the
# GPU inventory (condor_nodes reads nodes_voz.txt, because Condor's own GPU
# data is broken on this pool). The list then goes through the same code as
# --target, plus a rank that prefers the smallest GPU that fits.
GPU_SELECT=false
if [[ -n "$GPU_MODEL" || -n "$MIN_VRAM" ]]; then
    if [[ "$GPU_MODE" -eq 0 ]]; then
        echo "ERROR: --gpu-model / --vram cannot be combined with --cpu"
        exit 1
    fi
    if [[ -n "$TARGET_MACHINES" || "$LOCAL_MODE" == true ]]; then
        echo "ERROR: use either --target / --local or --gpu-model / --vram, not both"
        exit 1
    fi
    if ! command -v condor_nodes >/dev/null 2>&1; then
        echo "ERROR: condor_nodes not found in PATH: install it next to condor (it comes with the installer)"
        exit 1
    fi
    sel_args=(--select --gpu "$GPU_MODE")
    [[ -n "$GPU_MODEL" ]] && sel_args+=(--gpu-model "$GPU_MODEL")
    [[ -n "$MIN_VRAM" ]] && sel_args+=(--vram "$MIN_VRAM")
    TARGET_MACHINES=$(condor_nodes "${sel_args[@]}") || exit 1
    GPU_SELECT=true
    echo "GPU request -> nodes (best fit first): ${TARGET_MACHINES//,/, }"
fi

file=$1
n_jobs=${@: -1}

#-------------------------------------------------------------------
# create dir
mkdir -p .condor/

#-------------------------------------------------------------------
# base filename
args="$*"
args=${args// /_} 
args=${args//-/_} 
args=${args//\//_} 

file_condor_base=$args
if [[ "$APPEND_DATE" == true ]]; then
    file_condor_base="${file_condor_base}_$(date +%Y%m%d_%H%M%S_%N)"
fi

#-------------------------------------------------------------------
# lock check: warn if a previous job with the same name is still running
lock_file=.condor/${file_condor_base}._lock
clog_file=.condor/${file_condor_base}._clog
if [[ "$USE_LOCK" == true && -f "$lock_file" ]]; then
    if [[ -f "$clog_file" ]] && grep -qE '^005|^009' "$clog_file"; then
        echo "Previous job finished. Removing stale lock."
        rm -f "$lock_file"
    else
        echo -e "\e[1;31mWARNING: A job with the same name is already running or queued!\e[0m"
        echo -e "\e[1;31mLock file: $lock_file\e[0m"
        echo -e "\e[1;33mIf the previous job is no longer running, remove the lock manually:\e[0m"
        echo -e "\e[1;33m  rm $lock_file\e[0m"
        exit 1
    fi
fi

#-------------------------------------------------------------------
# create condor config
condor_task=.condor/${file_condor_base}._sub

#-------------------------------------------------------------------
if [ -f condor.cfg ];
then
    echo "condor.cfg exists."
    cp condor.cfg ${condor_task} 
else
   echo "condor.cfg does not exist, creating default"

   # build nice_user line
   if [[ "$NICE_MODE" == true ]]; then
       NICE_LINE="nice_user             = True"
   else
       NICE_LINE="#nice_user             = True"
   fi

#::::::::::::::::::::::::::::::::::::::::::
cat > ${condor_task}  << EOF

universe              = vanilla
notification          = Never 
${NICE_LINE}
getenv                = True
request_cpus          = 1
request_gpus          = ${GPU_MODE}
request_memory        = ${REQUEST_MEMORY} 
should_transfer_files = no

EOF
#::::::::::::::::::::::::::::::::::::::::::
fi

#-------------------------------------------------------------------
# if --local / --target, pin the jobs to one or more machines.
# --target accepts short names (voz08) and completes them with this host's
# domain. Several machines may be given comma-separated (voz04,voz08) or by
# repeating --target; condor then runs the jobs on whichever one has a free
# slot. --target wins over --local when both are given.
TARGET_REQ=""
if [[ -n "$TARGET_MACHINES" ]]; then
    IFS=',' read -r -a _targets <<< "$TARGET_MACHINES"
    for m in "${_targets[@]}"; do
        m="${m// /}"
        [[ -z "$m" ]] && continue
        if [[ "$m" != *.* && "$HOSTNAME" == *.* ]]; then
            m="${m}.${HOSTNAME#*.}"
        fi
        TARGET_REQ="${TARGET_REQ:+${TARGET_REQ} || }TARGET.Machine == \"${m}\""
    done
    if [[ -z "$TARGET_REQ" ]]; then
        echo "ERROR: --target needs at least one machine name (e.g. voz08 or voz04,voz08)"
        exit 1
    fi
elif [[ "$LOCAL_MODE" == true ]]; then
    TARGET_REQ="TARGET.Machine == \"${HOSTNAME}\""
fi
if [[ -n "$TARGET_REQ" ]]; then
    echo "requirements   = ( ${TARGET_REQ} )" >> ${condor_task}
fi
if [[ "$GPU_SELECT" == true ]]; then
    # prefer the machines at the start of the list (smallest GPU that fits)
    RANK_EXPR=""
    w=${#_targets[@]}
    for m in "${_targets[@]}"; do
        if [[ "$m" != *.* && "$HOSTNAME" == *.* ]]; then
            m="${m}.${HOSTNAME#*.}"
        fi
        RANK_EXPR="${RANK_EXPR:+${RANK_EXPR} + }(TARGET.Machine == \"${m}\") * ${w}"
        w=$((w - 1))
    done
    echo "rank           = ${RANK_EXPR}" >> ${condor_task}
fi

if [[ -n "$PRIO_TAG" ]]; then
    echo "+Prioridad = \"${PRIO_TAG}\"" >> ${condor_task}
fi

#-------------------------------------------------------------------
# append executable, arguments and per-job queue entries

#::::::::::::::::::::::::::::::::::::::::::
cat >> ${condor_task} << EOF
executable = `which ${file}`
arguments  = ${@:2:${#}-2} \$(icluster)
output     = .condor/${file_condor_base}_\$(ifile).log
error      = .condor/${file_condor_base}_\$(ifile).err
log        = .condor/${file_condor_base}._clog

EOF
#::::::::::::::::::::::::::::::::::::::::::

for((i=0;i<$n_jobs;i++)); do
  ifile=`echo $i | awk '{ printf("%03d",$1);}'`
      echo "
      ifile = $ifile
      icluster = $i
      queue " 
done >> ${condor_task}

#-------------------------------------------------------------------
# view the condor config

#cat ${condor_task}

#-------------------------------------------------------------------
# --dry-run: show the submit file and stop before submitting anything
if [[ "$DRY_RUN" == true ]]; then
    n_lines=$(wc -l < "${condor_task}")
    echo "-----------------------------"
    echo "Dry run: nothing was submitted."
    echo "Submit file: ${condor_task}"
    echo "-----------------------------"
    if (( n_lines > 60 )); then
        head -n 40 "${condor_task}"
        echo "... (${n_lines} lines in total, see ${condor_task})"
    else
        cat "${condor_task}"
    fi
    echo "-----------------------------"
    echo "To submit it, run the same command without --dry-run."
    exit 0
fi

#-------------------------------------------------------------------
# clean old condor log so condor_wait doesn't see stale events
rm -f .condor/${file_condor_base}._clog

#-------------------------------------------------------------------
# create lock file
if [[ "$USE_LOCK" == true ]]; then
    touch "$lock_file"
fi

#-------------------------------------------------------------------
# launch condor job

if [[ "$BLOCK_MODE" == "block" ]]; then
    _condor_submit.sh --sync y --config ${condor_task}
    if [[ "$USE_LOCK" == true ]]; then
        rm -f "$lock_file"
    fi
else
    _condor_submit.sh --config ${condor_task}
fi

#-------------------------------------------------------------------
# log
echo "-----------------------------"    
echo "log output: .condor/${file_condor_base}_[0-$(printf "%03d" $((n_jobs-1)))].log"
echo "err output: .condor/${file_condor_base}_[0-$(printf "%03d" $((n_jobs-1)))].err"
echo "-----------------------------"
